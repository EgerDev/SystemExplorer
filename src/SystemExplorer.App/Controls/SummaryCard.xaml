<UserControl
    x:Class="SystemExplorer.App.Controls.SummaryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="{StaticResource SummaryCardPadding}" MinHeight="72">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="{StaticResource ContentIconSize}" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="{StaticResource CaptionSize}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontSize="{StaticResource SummaryValueSize}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="{x:Bind AccessibleValue(Label, Value), Mode=OneWay}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
