<UserControl
    x:Class="SystemExplorer.App.Controls.SummaryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="12,10">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="18" VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="12"/>
                <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
