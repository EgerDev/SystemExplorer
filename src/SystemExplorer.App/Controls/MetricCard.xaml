<UserControl
    x:Class="SystemExplorer.App.Controls.MetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <Grid RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="{StaticResource ContentIconSize}" VerticalAlignment="Top" Margin="0,1,0,0" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Label, Mode=OneWay}" FontSize="{StaticResource BodySize}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{x:Bind Value, Mode=OneWay}" FontSize="{StaticResource MetricValueSize}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="{x:Bind AccessibleValue(Label, Value), Mode=OneWay}"/>
            <TextBlock Grid.Row="2" Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource Muted}" Visibility="{x:Bind DetailVisibility(Detail), Mode=OneWay}"/>
            <ContentPresenter Grid.Row="3" Content="{x:Bind Trend, Mode=OneWay}" Height="32" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{x:Bind TrendVisibility(Trend), Mode=OneWay}"/>
        </Grid>
    </Border>
</UserControl>
