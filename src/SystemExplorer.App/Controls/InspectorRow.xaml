<UserControl
    x:Class="SystemExplorer.App.Controls.InspectorRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{ThemeResource SubtleBorder}" BorderThickness="0,0,0,1" Padding="0,10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="{StaticResource ContentIconSize}" Margin="0,2,0,0" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="{StaticResource CaptionSize}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontSize="{StaticResource DataSize}" TextWrapping="Wrap" IsTextSelectionEnabled="True" IsTabStop="True" AutomationProperties.Name="{x:Bind AccessibleValue(Label, Value), Mode=OneWay}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
