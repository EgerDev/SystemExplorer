<UserControl x:Class="SystemExplorer.App.Views.RamAttributionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SystemExplorer.App.Controls">
    <UserControl.Resources>
        <x:Double x:Key="ExpanderHeaderMinHeight">32</x:Double>
        <DataTemplate x:Key="CompactHeader"><TextBlock Margin="0" Style="{StaticResource DataCell}" Text="{Binding}" FontWeight="SemiBold"/></DataTemplate>
    </UserControl.Resources>
    <Grid RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Message" Text="Frozen observations · read-only · no automatic elevation" Style="{StaticResource InvestigationStatus}" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <DropDownButton x:Name="ExportButton" Grid.Column="1" Content="Export">
                <DropDownButton.Flyout><MenuFlyout>
                    <MenuFlyoutItem Text="CSV" Tag="csv" Click="ExportClicked"/>
                    <MenuFlyoutItem Text="JSON" Tag="json" Click="ExportClicked"/>
                </MenuFlyout></DropDownButton.Flyout>
            </DropDownButton>
        </Grid>
        <Pivot x:Name="Tabs" Grid.Row="1" HeaderTemplate="{StaticResource CompactHeader}">
            <PivotItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Padding="0,4,4,8">
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <controls:SummaryCard x:Name="UsableCard" Label="Usable physical memory" Glyph="&#xE964;"/>
                            <controls:SummaryCard x:Name="InUseCard" Grid.Column="1" Label="In use (excluding modified)" Glyph="&#xE950;"/>
                            <controls:SummaryCard x:Name="AvailableCard" Grid.Row="1" Label="Available (standby + free / zero)" Glyph="&#xE9D9;"/>
                            <controls:SummaryCard x:Name="ReservedCard" Grid.Row="1" Grid.Column="1" Label="Hardware reserved" Glyph="&#xE946;"/>
                        </Grid>
                        <TextBlock x:Name="MachineNote" Style="{StaticResource InvestigationStatus}" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock Text="Where usable RAM goes" Style="{StaticResource SectionLabel}"/>
                        <Grid x:Name="Composition" Height="22" CornerRadius="4"/>
                        <TextBlock x:Name="BarNote" Style="{StaticResource InvestigationStatus}" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <GridView x:Name="Legend" SelectionMode="None" IsItemClickEnabled="False" IsTabStop="False" Padding="0" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="330" ItemHeight="80"/></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></GridView.ItemContainerStyle>
                        </GridView>
                        <TextBlock Text="Process working sets double-count shared pages; private working sets do not." Style="{StaticResource Muted}"/>
                        <Expander Header="What do these numbers mean?" HorizontalAlignment="Stretch"><TextBlock Text="The bar partitions usable memory using measured categories and an honest remainder. Sources are not atomic and may overlap; a negative remainder is shown as overlap, never clamped. Installed / hardware-reserved memory can be unavailable independently of usable memory." Style="{StaticResource Muted}"/></Expander>
                        <ContentControl x:Name="MachineTable" HorizontalContentAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Processes">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Private resident excludes shared pages; proportional values are upper-bound estimates." Style="{StaticResource InvestigationStatus}"/>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top"><Button x:Name="ProcessScan" Content="Scan processes" Click="ProcessScanClicked" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="ProcessCancel" Content="Cancel" Click="CancelClicked" IsEnabled="False"/></StackPanel>
                        <Expander Grid.Column="1" Header="What do these numbers mean?" HorizontalAlignment="Stretch"><ScrollViewer MaxHeight="120"><TextBlock Text="Private resident = non-shareable working-set pages. Actually shared = shareable pages with more than one sharer. Shareable (sole) = shareable pages with at most one sharer. Proportional est. divides each shareable page by ShareCount; ShareCount saturates at 7, so this is an upper-bound estimate, not unique physical RAM. Commit is backing storage, not resident RAM. Process identities are frozen at dialog open; an exited or reused PID is not attributed to its replacement." Style="{StaticResource Muted}"/></ScrollViewer></Expander>
                        </Grid>
                        <ProgressBar x:Name="ProcessProgress" Minimum="0" Maximum="1" Value="0"/>
                        <TextBlock x:Name="ProcessStatus" Text="Not scanned. Process identities are frozen from the app snapshot at dialog open." Style="{StaticResource InvestigationStatus}" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Border x:Name="ProcessEmpty" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,12,0,0">
                            <StackPanel Spacing="8"><TextBlock Text="Inspect process memory" Style="{StaticResource SectionLabel}"/><TextBlock Text="Choose Scan processes above to capture a bounded, frozen observation. No process memory contents are read. Results and per-process availability will appear here." Style="{StaticResource Muted}"/></StackPanel>
                        </Border>
                        <ContentControl x:Name="ProcessTable" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </Grid>
                </Grid>
            </PivotItem>
            <PivotItem Header="Pool tags">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Candidate drivers are string-match leads, not proof of allocation ownership." Style="{StaticResource InvestigationStatus}"/>
                        <Expander Header="What do these numbers mean?" HorizontalAlignment="Stretch"><ScrollViewer MaxHeight="120"><TextBlock Text="Local .sys files and kernel images only; no network or pooltag.txt database. Unknown means no scanned local file contained the tag, not that a driver is excluded. Candidate names are capped; the tooltip reports total matches and scan limitations." Style="{StaticResource Muted}"/></ScrollViewer></Expander>
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="FindDrivers" Content="Find drivers" Click="FindDriversClicked" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="PoolCancel" Content="Cancel" Click="CancelClicked" IsEnabled="False"/></StackPanel>
                        <ProgressBar x:Name="PoolProgress" Minimum="0" Maximum="1" Value="0"/>
                        <TextBlock x:Name="PoolStatus" Text="Capturing pool tags…" Style="{StaticResource InvestigationStatus}" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                    <ContentControl x:Name="PoolTable" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Grid>
            </PivotItem>
            <PivotItem Header="Physical memory (admin)">
                <Grid>
                        <Border x:Name="AdminCard" Style="{StaticResource Card}" Visibility="Collapsed"><TextBlock Text="Requires administrator — restart SystemExplorer as administrator to view physical page lists. Nothing is elevated automatically." Style="{StaticResource SectionLabel}"/></Border>
                        <Grid x:Name="PhysicalPanel" RowSpacing="6">
                          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                          <StackPanel Spacing="6">
                            <TextBlock Text="Read-only PFN page counts are separate from Overview performance counters." Style="{StaticResource InvestigationStatus}"/>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top"><Button x:Name="PhysicalScan" Style="{StaticResource AccentButtonStyle}" Content="Scan physical pages" Click="PhysicalScanClicked"/><Button x:Name="PhysicalCancel" Content="Cancel" Click="CancelClicked" IsEnabled="False"/><ComboBox x:Name="PhysicalTableSelector" Width="140" SelectedIndex="0" SelectionChanged="PhysicalTableChanged" AutomationProperties.Name="Physical memory table"><x:String>Use × list</x:String><x:String>Priorities</x:String><x:String>File objects</x:String></ComboBox></StackPanel>
                            <Expander Grid.Column="1" Header="What do these numbers mean?" HorizontalAlignment="Stretch"><ScrollViewer MaxHeight="120"><TextBlock Text="Explicit, bounded read-only PFN attribute scan. SeProfileSingleProcessPrivilege is enabled in this process only during the scan, then restored. PFN use counts and performance counters are separate sources; their definitions can disagree. Zero / Free / Bad pages have no meaningful use and are shown as Unused. Repurposed counts are cumulative, not current residency. File names are unavailable: resolving kernel file objects requires a driver or DuplicateHandle; both are excluded. At most 256 file objects plus Other. Opaque ordinals apply only to this capture." Style="{StaticResource Muted}"/></ScrollViewer></Expander>
                            </Grid>
                            <ProgressBar x:Name="PhysicalProgress" Minimum="0" Maximum="1" Value="0"/>
                            <TextBlock x:Name="PhysicalStatus" Text="Not scanned. No physical-page query has been made." Style="{StaticResource InvestigationStatus}" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                          <Grid Grid.Row="1">
                            <ContentControl x:Name="UseTable" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTipService.ToolTip="Pages, source: Superfetch PFN attributes"/>
                            <ContentControl x:Name="PriorityTable" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTipService.ToolTip="Standby / repurposed pages, source: SystemMemoryListInformation"/>
                            <ContentControl x:Name="FileTable" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTipService.ToolTip="Opaque ordinals, names unavailable; source: Superfetch PFN attributes"/>
                          </Grid>
                        </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
