<UserControl
    x:Class="SystemExplorer.App.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SystemExplorer.App.Views"
    xmlns:controls="using:SystemExplorer.App.Controls">
    <ScrollViewer x:Name="DashboardScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsTabStop="False">
        <Grid x:Name="Dashboard" SizeChanged="DashboardSizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="ResourcesGrid" Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <controls:MetricCard x:Name="CpuCard" Label="CPU" Glyph="&#xE9D9;">
                    <controls:MetricCard.Trend><views:ResourceTrendView x:Name="CpuTrend"/></controls:MetricCard.Trend>
                </controls:MetricCard>
                <controls:MetricCard x:Name="MemoryCard" Grid.Column="1" Label="Physical memory" Glyph="&#xE964;">
                    <controls:MetricCard.Trend><views:ResourceTrendView x:Name="MemoryTrend"/></controls:MetricCard.Trend>
                </controls:MetricCard>
                <controls:MetricCard x:Name="DiskCard" Grid.Column="2" Label="Disk throughput" Glyph="&#xEDA2;">
                    <controls:MetricCard.Trend><views:ResourceTrendView x:Name="DiskTrend"/></controls:MetricCard.Trend>
                </controls:MetricCard>
                <controls:MetricCard x:Name="NetworkCard" Grid.Column="3" Label="Network" Glyph="&#xE701;" Value="Unavailable" Detail="Bandwidth is not measured.">
                    <controls:MetricCard.Trend><TextBlock x:Name="NetworkObservation" Style="{StaticResource Muted}" VerticalAlignment="Center"/></controls:MetricCard.Trend>
                </controls:MetricCard>
            </Grid>
            <Grid x:Name="PanelsGrid" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="ConsumersPanel" Style="{StaticResource Card}">
                    <Grid x:Name="ConsumersLayout" RowSpacing="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid x:Name="ConsumerHeader" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Top Resource Consumers" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="ConsumerCaption" Text="Applications and observed process groups" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <ComboBox x:Name="RankingSelector" Grid.Column="1" SelectedIndex="0" SelectionChanged="RankingSelectionChanged" VerticalAlignment="Top" AutomationProperties.Name="Rank top resource consumers">
                                <x:String>Private commit</x:String><x:String>CPU</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="ConsumerTableHeader" Grid.Row="1" Background="{ThemeResource HeaderSurface}" Padding="10,8,42,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="106"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Application / process" FontSize="{StaticResource CaptionSize}"/>
                            <TextBlock x:Name="ConsumerCommitHeader" Grid.Column="1" Text="Private commit" FontSize="{StaticResource CaptionSize}" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="ConsumerCpuHeader" Grid.Column="2" Text="CPU" FontSize="{StaticResource CaptionSize}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ListView x:Name="ConsumersList" Grid.Row="2" ItemsSource="{x:Bind Rows}" SelectionMode="Single" MaxHeight="80" KeyDown="ConsumerKeyDown" AutomationProperties.Name="Ranked resource consumers" AutomationProperties.HelpText="Applications and observed process groups, ranked by the selected resource." ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="views:OverviewConsumerRow">
                                    <Grid Padding="4,2" ColumnSpacing="8" BorderBrush="{ThemeResource SubtleBorder}" BorderThickness="0,0,0,1" ToolTipService.ToolTip="{x:Bind IdentityExplanation, Mode=OneWay}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="106"/><ColumnDefinition Width="62"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="8" Margin="{x:Bind Indent}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Padding="2" MinWidth="24" MinHeight="28" VerticalAlignment="Center" Click="ExpandClicked" Tag="{x:Bind}" Visibility="{x:Bind ExpandVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind ExpandName, Mode=OneWay}" ToolTipService.ToolTip="Expand or collapse observed members">
                                                <FontIcon FontSize="12" Glyph="{x:Bind Chevron, Mode=OneWay}"/>
                                            </Button>
                                            <Grid Grid.Column="1" VerticalAlignment="Center" Width="26" Height="26">
                                                <FontIcon Glyph="&#xE737;" FontSize="22" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw"/>
                                                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="26" Height="26" AutomationProperties.AccessibilityView="Raw"/>
                                            </Grid>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="{x:Bind NameWeight}" FontSize="{StaticResource BodySize}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Secondary, Mode=OneWay}" FontSize="{StaticResource CaptionSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Memory, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="{StaticResource DataSize}" FontWeight="{x:Bind NameWeight}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Cpu, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="{StaticResource DataSize}"/>
                                        <Button Grid.Column="3" Padding="3" MinWidth="28" MinHeight="30" VerticalAlignment="Center" Click="InspectClicked" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind InspectName, Mode=OneWay}" ToolTipService.ToolTip="Inspect this process (read-only)"><FontIcon Glyph="&#xE721;" FontSize="16"/></Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyConsumers" Grid.Row="2" Text="Waiting for the first live sample…" Style="{StaticResource Muted}" Margin="8,20"/>
                        <Grid x:Name="ConsumerFooter" Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Private commit is not physical RAM." Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTipService.ToolTip="Private commit is virtual memory, not physical RAM. — means unavailable." AutomationProperties.HelpText="Private commit is virtual memory, not physical RAM. — means unavailable."/>
                            <HyperlinkButton Grid.Column="1" Content="View all processes" Click="ViewProcessesClicked" Padding="0,4" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="InsightsPanel" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="True" AutomationProperties.Name="System insight observations">
                            <StackPanel x:Name="InsightsContent" Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEA80;" FontSize="26" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw"/>
                                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="System Insights" Style="{StaticResource SectionLabel}"/></StackPanel>
                                </Grid>
                                <Border x:Name="MemorySummary" Background="{ThemeResource SelectionSurface}" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="6"><TextBlock x:Name="MemoryHeadline" Text="Physical memory" Style="{StaticResource SectionLabel}" Foreground="{ThemeResource SelectionForeground}"/><TextBlock x:Name="MemoryEvidence" Text="Waiting for measurements…" TextWrapping="Wrap" FontSize="{StaticResource BodySize}" Foreground="{ThemeResource SelectionForeground}"/></StackPanel>
                                </Border>
                                <Grid x:Name="MemoryFacts" ColumnSpacing="12" RowSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Available physical" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="AvailableValue" Grid.Column="1" HorizontalAlignment="Right" AutomationProperties.Name="Available physical memory"/>
                                    <TextBlock Grid.Row="1" Text="Cache (overlaps physical)" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="CacheValue" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" AutomationProperties.Name="System cache, overlaps physical memory"/>
                                    <TextBlock Grid.Row="2" Text="Virtual commit / limit" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="CommitValue" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" AutomationProperties.Name="Committed virtual memory and limit"/>
                                </Grid>
                                <TextBlock Text="Cache and commit are different views, not additional physical usage." Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="InsightsAction" Grid.Row="1" Click="InsightsClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="View detailed analysis" TextWrapping="Wrap"/><FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Margin="8,0,0,0"/></Grid>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <TextBlock x:Name="ReadingStatus" Margin="0,0,0,12" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </ScrollViewer>
</UserControl>
