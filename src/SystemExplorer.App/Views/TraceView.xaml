<UserControl x:Class="SystemExplorer.App.Views.TraceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="ViewSizeChanged">
    <Grid RowSpacing="6">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="ResultsRow" Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="Actions" ColumnSpacing="6" RowSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button x:Name="StartButton" Content="Start recording" Click="StartClicked" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Click="StopClicked" IsEnabled="False"/>
            <Button x:Name="CsvButton" Grid.Column="2" Content="Export CSV" Tag="csv" Click="ExportClicked" IsEnabled="False"/>
            <Button x:Name="JsonButton" Grid.Column="3" Content="Export JSON" Tag="json" Click="ExportClicked" IsEnabled="False"/>
            <Button x:Name="ClearButton" Grid.Column="4" Content="Clear" Click="ClearClicked"/>
        </Grid>
        <ScrollViewer x:Name="TopScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <InfoBar x:Name="AdminNotice" IsOpen="False" IsClosable="False" Severity="Informational" Message="Requires administrator — restart SystemExplorer as administrator to record. No elevation is attempted."/>
                <Expander x:Name="Setup" Header="Recording options" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="SetupControls" Spacing="8">
                        <Grid x:Name="CategorySetup" ColumnSpacing="8" RowSpacing="2">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <CheckBox x:Name="Processes" Content="Processes" IsChecked="True"/>
                            <CheckBox x:Name="Threads" Grid.Column="1" Content="Threads" IsChecked="True"/>
                            <CheckBox x:Name="Images" Grid.Column="2" Content="Images" IsChecked="True"/>
                            <CheckBox x:Name="Files" Grid.Column="3" Content="File" IsChecked="True"/>
                            <CheckBox x:Name="Registry" Grid.Column="4" Content="Registry" IsChecked="True"/>
                            <CheckBox x:Name="Network" Grid.Column="5" Content="Network" IsChecked="True"/>
                        </Grid>
                        <Grid x:Name="OptionSetup" ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ComboBox x:Name="Duration" Header="Duration" SelectedIndex="2" HorizontalAlignment="Stretch" AutomationProperties.Name="Trace duration">
                                <x:String>30 seconds</x:String><x:String>1 minute</x:String><x:String>2 minutes</x:String><x:String>5 minutes</x:String><x:String>10 minutes</x:String>
                            </ComboBox>
                            <ComboBox x:Name="EventCap" Grid.Column="1" Header="Event cap" SelectedIndex="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Trace event cap">
                                <x:String>100,000</x:String><x:String>200,000</x:String><x:String>500,000</x:String>
                            </ComboBox>
                            <ToggleSwitch x:Name="ExcludeSelf" Grid.Column="2" Header="Exclude SystemExplorer" IsOn="True"/>
                        </Grid>
                    </StackPanel>
                </Expander>
                <Border Style="{StaticResource Card}" Padding="10,4">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="CaptureStatus" Text="Not started · ready for an opt-in recording" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="Counters" Text="Elapsed 0:00 · Events 0 · Processes started 0 · Lost 0 · Dropped 0" FontSize="12" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="Notice" Text="Start a recording to observe local activity. Nothing is saved automatically." FontSize="12" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                <StackPanel x:Name="Filters" Spacing="6" Visibility="Collapsed">
                    <Grid x:Name="FilterFirst" ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ComboBox x:Name="ProcessPicker" SelectedIndex="0" SelectionChanged="ProcessChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Filter trace process"/>
                        <CheckBox x:Name="Descendants" Grid.Column="1" Content="Descendants" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged"/>
                        <ComboBox x:Name="CategoryPicker" Grid.Column="2" SelectedIndex="0" SelectionChanged="FilterSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Filter trace category">
                            <x:String>All categories</x:String><x:String>Process</x:String><x:String>Image</x:String><x:String>File</x:String><x:String>Registry</x:String><x:String>Network</x:String>
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="FilterSecond" ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBox x:Name="Search" PlaceholderText="Search path, detail, process or PID" TextChanged="FilterTextChanged" AutomationProperties.Name="Search trace events"/>
                        <TextBox x:Name="From" Grid.Column="1" PlaceholderText="From (s)" TextChanged="FilterTextChanged" AutomationProperties.Name="Trace range from seconds"/>
                        <TextBox x:Name="To" Grid.Column="2" PlaceholderText="To (s)" TextChanged="FilterTextChanged" AutomationProperties.Name="Trace range to seconds"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="ResultsLayout" Grid.Row="2" ColumnSpacing="8" RowSpacing="6" SizeChanged="ResultsSizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="SummaryColumn" Width="0"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="ViewTabs" Orientation="Horizontal" Spacing="6" Padding="8,0" Visibility="Collapsed">
                        <ToggleButton x:Name="EventsTab" Content="Events" IsChecked="True" Click="EventsClicked"/>
                        <ToggleButton x:Name="TreeTab" Content="Process tree" Click="TreeClicked"/>
                        <Button x:Name="SummaryButton" Content="Summary" Visibility="Collapsed" Click="SummaryClicked"/>
                    </StackPanel>
                    <Grid x:Name="EventHeader" Grid.Row="1" Padding="10,6" Background="{ThemeResource HeaderSurface}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="140"/><ColumnDefinition Width="116"/><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Time" FontSize="12" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Process (PID)" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Operation" FontSize="12" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Path / target · detail" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Bytes" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                    <ListView x:Name="Timeline" Grid.Row="2" SelectionChanged="EventSelected" ScrollViewer.HorizontalScrollMode="Disabled" AutomationProperties.Name="Activity trace timeline">
                        <ListView.ItemTemplate><DataTemplate>
                            <Grid Padding="10,4" MinHeight="32" ToolTipService.ToolTip="{Binding Description}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="140"/><ColumnDefinition Width="116"/><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Process}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Operation}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0"><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" TextTrimming="CharacterEllipsis" FontSize="11" Style="{StaticResource Muted}"/></StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding Bytes}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="32"/></Style></ListView.ItemContainerStyle>
                    </ListView>
                    <Grid x:Name="TreeHeader" Grid.Row="1" Padding="10,6" Background="{ThemeResource HeaderSurface}" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Process · parent → child" FontSize="12" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Start" FontSize="12" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Exit / code" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                    <ListView x:Name="ProcessTree" Grid.Row="2" Visibility="Collapsed" SelectionChanged="TreeSelected" AutomationProperties.Name="Recorded process tree">
                        <ListView.ItemTemplate><DataTemplate>
                            <Grid Height="54" Padding="10,5" ToolTipService.ToolTip="{Binding Description}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="{Binding Indent}" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Parent}" FontSize="11" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}"/></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Start}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Exit}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                    </ListView>
                    <TextBlock x:Name="Empty" Grid.Row="2" Text="Your recorded activity will appear here." Margin="16" FontSize="13" TextWrapping="Wrap" IsHitTestVisible="False"/>
                    <TextBlock x:Name="ViewCount" Grid.Row="3" Margin="10,5" Text="No recording" FontSize="11" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </Grid>
            </Border>
            <Expander x:Name="Summary" Grid.Column="1" Header="Process summary" IsExpanded="True" HorizontalAlignment="Stretch" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                <ScrollViewer x:Name="SummaryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SummaryTitle" Text="Select an event or process" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <Button x:Name="InspectButton" Content="Inspect live process" Click="InspectClicked" IsEnabled="False"/>
                        <TextBlock x:Name="InspectReason" FontSize="11" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock x:Name="TopText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </ScrollViewer>
            </Expander>
        </Grid>
        <Expander x:Name="LimitsPanel" Grid.Row="3" Header="Read-only · limitations and capture details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Limitations" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
        </Expander>
    </Grid>
</UserControl>
