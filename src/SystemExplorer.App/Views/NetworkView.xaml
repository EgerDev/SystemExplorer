<UserControl
    x:Class="SystemExplorer.App.Views.NetworkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SystemExplorer.App.Controls"
    xmlns:views="using:SystemExplorer.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Padding="0,0,0,12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hardware adapter throughput and observed TCP/UDP endpoints · No inferred DNS, bandwidth, or geography"
                           Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Adapters" Tag="Adapters" Click="ActionClick"/>
                    <Button Content="Capture I/O" Tag="IoAttribution" Click="ActionClick" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- 4 Semantic KPI Cards -->
            <Grid x:Name="NetKpiGrid" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:SummaryCard x:Name="RxRateCard" Label="Receive" Glyph="&#xE896;" Value="—"
                                      AccentBrush="{ThemeResource StatusLiveBrush}"/>
                <controls:SummaryCard x:Name="TxRateCard" Grid.Column="1" Label="Transmit" Glyph="&#xE898;" Value="—"
                                      AccentBrush="{ThemeResource ChartVioletBrush}"/>
                <controls:SummaryCard x:Name="TcpCard" Grid.Column="2" Label="TCP connections" Glyph="&#xE774;" Value="—"
                                      AccentBrush="{ThemeResource InteractionAccent}"/>
                <controls:SummaryCard x:Name="UdpCard" Grid.Column="3" Label="UDP endpoints" Glyph="&#xE968;" Value="—"
                                      AccentBrush="{ThemeResource StatusWarnBrush}"/>
            </Grid>

            <!-- Split: Adapters (1*) + Endpoints table (1.65*) -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.65*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Network adapters" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{ThemeResource GroupSurface}" BorderBrush="{ThemeResource SubtleBorder}"
                                    BorderThickness="1" CornerRadius="10" Padding="8,2">
                                <TextBlock x:Name="NetStatusBadge" Text="Warming up" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{ThemeResource ChartVioletBrush}"/>
                            </Border>
                        </Grid>

                        <ItemsControl x:Name="AdaptersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="views:NetAdapterCardItem">
                                    <Border Background="{ThemeResource GroupSurface}" BorderBrush="{ThemeResource SubtleBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Alias}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind StatusBrush}"/>
                                            </Grid>
                                            <TextBlock Text="{x:Bind RatesText}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                            <TextBlock Text="{x:Bind MetaText}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="AdaptersEmpty" Text="Warming up network adapter counters…" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Observed connections &amp; endpoints" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="EndpointCountText" Grid.Column="1" Text="0 shown" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnSpacing="8" Padding="4,4" BorderBrush="{ThemeResource SubtleBorder}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="68"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Local" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Remote" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="State" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Owner" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="" Style="{StaticResource Muted}"/>
                        </Grid>

                        <ItemsControl x:Name="EndpointsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="views:NetEndpointItem">
                                    <Grid ColumnSpacing="8" Padding="4,6" BorderBrush="{ThemeResource SubtleBorder}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="68"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Local}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Remote}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind State}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{x:Bind StateBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Owner}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="4" Content="Inspect" Tag="{x:Bind OwnerIdentity}" Click="InspectClick"
                                                IsEnabled="{x:Bind CanInspect}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,3"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EndpointsEmpty" Text="No matching network endpoints." Style="{StaticResource Muted}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
