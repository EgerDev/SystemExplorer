<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageSurface" Color="#F7F8FA"/>
            <SolidColorBrush x:Key="GroupSurface" Color="#F0F2F5"/>
            <SolidColorBrush x:Key="HeaderSurface" Color="#F4F5F8"/>
            <SolidColorBrush x:Key="CardSurface" Color="#FCFCFD"/>
            <SolidColorBrush x:Key="SubtleBorder" Color="#DDE1E8"/>
            <SolidColorBrush x:Key="SelectionSurface" Color="#E2EDFC"/>
            <SolidColorBrush x:Key="SelectionForeground" Color="#153A67"/>
            <SolidColorBrush x:Key="InteractionAccent" Color="#0067C0"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="PageSurface" Color="#202124"/>
            <SolidColorBrush x:Key="GroupSurface" Color="#2B2D31"/>
            <SolidColorBrush x:Key="HeaderSurface" Color="#25272B"/>
            <SolidColorBrush x:Key="CardSurface" Color="#292B2F"/>
            <SolidColorBrush x:Key="SubtleBorder" Color="#41444B"/>
            <SolidColorBrush x:Key="SelectionSurface" Color="#233D5A"/>
            <SolidColorBrush x:Key="SelectionForeground" Color="#E0EEFF"/>
            <SolidColorBrush x:Key="InteractionAccent" Color="#75B9F5"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PageSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="GroupSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="HeaderSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="CardSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="SubtleBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="SelectionSurface" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="SelectionForeground" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="InteractionAccent" Color="{ThemeResource SystemColorHotlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <x:Double x:Key="BodySize">14</x:Double>
    <x:Double x:Key="DataSize">14</x:Double>
    <x:Double x:Key="CaptionSize">13</x:Double>
    <x:Double x:Key="SectionHeadingSize">16</x:Double>
    <x:Double x:Key="PageHeadingSize">28</x:Double>
    <x:Double x:Key="SummaryValueSize">24</x:Double>
    <x:Double x:Key="MetricValueSize">28</x:Double>
    <x:Double x:Key="ContentIconSize">20</x:Double>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="RowCornerRadius">6</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="SummaryCardPadding">12,10</Thickness>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardSurface}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource SubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource DataSize}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SectionHeadingSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="PageHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PageHeadingSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
    </Style>
    <Style x:Key="DataCell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DataSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="8,0"/>
    </Style>
    <Style x:Key="NumericCell" TargetType="TextBlock" BasedOn="{StaticResource DataCell}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="ColumnHeader" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource CaptionSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style x:Key="ReadOnlyAction" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,9"/>
    </Style>
</ResourceDictionary>
