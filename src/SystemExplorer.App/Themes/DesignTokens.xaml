<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageSurface" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="GroupSurface" Color="#F9FAFB"/>
            <SolidColorBrush x:Key="HeaderSurface" Color="#ECEEF2"/>
            <SolidColorBrush x:Key="CardSurface" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SubtleBorder" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="SelectionSurface" Color="#EFF6FF"/>
            <SolidColorBrush x:Key="SelectionForeground" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="InteractionAccent" Color="#0067C0"/>
            <SolidColorBrush x:Key="StatusLiveBrush" Color="#10B981"/>
            <SolidColorBrush x:Key="StatusLiveSurface" Color="#ECFDF5"/>
            <SolidColorBrush x:Key="StatusWarnBrush" Color="#D97706"/>
            <SolidColorBrush x:Key="StatusWarnSurface" Color="#FEF3C7"/>
            <SolidColorBrush x:Key="StatusDangerBrush" Color="#DC2626"/>
            <SolidColorBrush x:Key="StatusDangerSurface" Color="#FEF2F2"/>
            <SolidColorBrush x:Key="ChartVioletBrush" Color="#7C3AED"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="PageSurface" Color="#202124"/>
            <SolidColorBrush x:Key="GroupSurface" Color="#2B2D31"/>
            <SolidColorBrush x:Key="HeaderSurface" Color="#25272B"/>
            <SolidColorBrush x:Key="CardSurface" Color="#292B2F"/>
            <SolidColorBrush x:Key="SubtleBorder" Color="#41444B"/>
            <SolidColorBrush x:Key="SelectionSurface" Color="#233D5A"/>
            <SolidColorBrush x:Key="SelectionForeground" Color="#E0EEFF"/>
            <SolidColorBrush x:Key="InteractionAccent" Color="#75B9F5"/>
            <SolidColorBrush x:Key="StatusLiveBrush" Color="#34D399"/>
            <SolidColorBrush x:Key="StatusLiveSurface" Color="#14332A"/>
            <SolidColorBrush x:Key="StatusWarnBrush" Color="#FBBF24"/>
            <SolidColorBrush x:Key="StatusWarnSurface" Color="#3A2B12"/>
            <SolidColorBrush x:Key="StatusDangerBrush" Color="#F87171"/>
            <SolidColorBrush x:Key="StatusDangerSurface" Color="#3B1D20"/>
            <SolidColorBrush x:Key="ChartVioletBrush" Color="#A78BFA"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PageSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="GroupSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="HeaderSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="CardSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="SubtleBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="SelectionSurface" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="SelectionForeground" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="InteractionAccent" Color="{ThemeResource SystemColorHotlightColor}"/>
            <SolidColorBrush x:Key="StatusLiveBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
            <SolidColorBrush x:Key="StatusLiveSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="StatusWarnBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
            <SolidColorBrush x:Key="StatusWarnSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="StatusDangerBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
            <SolidColorBrush x:Key="StatusDangerSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="ChartVioletBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <x:Double x:Key="BodySize">14</x:Double>
    <x:Double x:Key="DataSize">14</x:Double>
    <x:Double x:Key="CaptionSize">13</x:Double>
    <x:Double x:Key="SectionHeadingSize">16</x:Double>
    <x:Double x:Key="PageHeadingSize">26</x:Double>
    <x:Double x:Key="SummaryValueSize">22</x:Double>
    <x:Double x:Key="MetricValueSize">26</x:Double>
    <x:Double x:Key="ContentIconSize">18</x:Double>
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="RowCornerRadius">6</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="SummaryCardPadding">14,11</Thickness>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardSurface}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource SubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource DataSize}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="InvestigationStatus" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="MaxLines" Value="2"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SectionHeadingSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="PageHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PageHeadingSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
    </Style>
    <Style x:Key="DataCell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DataSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="8,0"/>
    </Style>
    <Style x:Key="NumericCell" TargetType="TextBlock" BasedOn="{StaticResource DataCell}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    </Style>
    <Style x:Key="ColumnHeader" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource CaptionSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style x:Key="ReadOnlyAction" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,9"/>
    </Style>
</ResourceDictionary>
