<Window
    x:Class="SystemExplorer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.App"
    xmlns:controls="using:SystemExplorer.App.Controls"
    xmlns:views="using:SystemExplorer.App.Views"
    Title="SystemExplorer">
    <Grid x:Name="Root" Background="{ThemeResource PageSurface}" RequestedTheme="Light" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <controls:ProcessColumns x:Key="ProcessColumns"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <TitleBar x:Name="WindowTitleBar" Title="SystemExplorer">
            <TitleBar.IconSource><SymbolIconSource Symbol="ShowResults"/></TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="GlobalSearch" PlaceholderText="Search this section…  Ctrl+K" QueryIcon="Find" TextChanged="GlobalSearchChanged" AutomationProperties.Name="Search current section" AutomationProperties.AcceleratorKey="Ctrl+K" MaxWidth="600" HorizontalAlignment="Stretch"/>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button x:Name="PauseButton" Content="Pause" Click="PauseClicked" AutomationProperties.Name="Pause live refresh"/>
            </TitleBar.RightHeader>
        </TitleBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" ExpandedModeThresholdWidth="900" CompactModeThresholdWidth="640" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="192" CompactPaneLength="48" IsPaneToggleButtonVisible="True" SelectionChanged="NavigationChanged" AlwaysShowHeader="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Overview" Icon="Home"/>
                <NavigationViewItem Content="Processes" Tag="Processes" Icon="AllApps" IsSelected="True"/>
                <NavigationViewItem Content="Memory" Tag="Memory">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="CPU" Tag="CPU">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="GPU" Tag="GPU">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Disks" Tag="Disks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Network" Tag="Network" Icon="World"/>
                <NavigationViewItem Content="Services" Tag="Services" Icon="Repair"/>
                <NavigationViewItem Content="Startup" Tag="Startup" Icon="Play"/>
                <NavigationViewItem Content="Insights" Tag="Insights">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA80;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting"/>
                <NavigationViewItem Content="Help" Tag="Help" Icon="Help"/>
            </NavigationView.FooterMenuItems>
            <Grid Padding="16,8,16,12" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="PageTitle" Text="Processes" Style="{StaticResource PageHeading}"/>
                    <TextBlock x:Name="PageSubtitle" Text="See what's using your system and explore related processes." Style="{StaticResource Muted}"/>
                </StackPanel>
                <Grid x:Name="ProcessesPanel" Grid.Row="1" Grid.RowSpan="2" ColumnSpacing="12" SizeChanged="ProcessesSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="InspectorColumn" Width="320"/>
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition x:Name="MemorySummaryColumn"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <controls:SummaryCard Label="Processes" Value="{x:Bind Model.ProcessCount, Mode=OneWay}" Glyph="&#xE950;"/>
                            <controls:SummaryCard Grid.Column="1" Label="Process groups" Value="{x:Bind Model.GroupCount, Mode=OneWay}" Glyph="&#xE8FD;" ToolTipService.ToolTip="Groups use the same executable, owner and observed parent chain; single processes are included."/>
                            <controls:SummaryCard Grid.Column="2" Label="Memory in use" Value="{x:Bind Model.MemoryUsed, Mode=OneWay}" Glyph="&#xE964;" ToolTipService.ToolTip="Physical memory in use across the system. Not the sum of process private commit."/>
                            <controls:SummaryCard Grid.Column="3" Label="System CPU" Value="{x:Bind Model.CpuUsed, Mode=OneWay}" Glyph="&#xE9D9;"/>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="156"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProcessSearch" PlaceholderText="Search processes…" TextChanged="ProcessSearchChanged" AutomationProperties.Name="Filter processes"/>
                            <ComboBox x:Name="Grouping" Grid.Column="1" SelectedIndex="0" SelectionChanged="OptionsChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Group processes">
                                <x:String>Application</x:String>
                                <x:String>Individual</x:String>
                            </ComboBox>
                            <ComboBox x:Name="Sorting" Grid.Column="2" SelectedIndex="0" SelectionChanged="OptionsChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort processes">
                                <x:String>Private commit</x:String>
                                <x:String>CPU</x:String>
                                <x:String>Name</x:String>
                                <x:String>PID</x:String>
                            </ComboBox>
                            <Button Grid.Column="3" Click="ReverseSortClicked" AutomationProperties.Name="Reverse sort direction" ToolTipService.ToolTip="Reverse sort direction">
                                <FontIcon Glyph="&#xE8CB;" FontSize="15"/>
                            </Button>
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" SizeChanged="TableSizeChanged">
                            <Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" IsTabStop="False">
                                    <Grid Width="{Binding TableWidth, Source={StaticResource ProcessColumns}, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{ThemeResource HeaderSurface}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Grid Width="{Binding ContentWidth, Source={StaticResource ProcessColumns}, Mode=OneWay}" HorizontalAlignment="Left" Margin="8,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Name, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding Memory, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding Cpu, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding Io, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding Threads, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding User, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding Status, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding Pid, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Button Content="Process name" Tag="Name" Click="ColumnSortClicked" Style="{StaticResource ColumnHeader}" Margin="0,0,12,0" ToolTipService.ToolTip="Sort by Process name"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="0" AutomationProperties.Name="Resize Process name column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="1">
                                                    <Button Content="Private commit" Tag="Private memory" Click="ColumnSortClicked" Style="{StaticResource ColumnHeader}" Margin="0,0,12,0" ToolTipService.ToolTip="Private commit is not physical RAM"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="1" AutomationProperties.Name="Resize Private commit column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="2">
                                                    <Button Content="CPU %" Tag="CPU" Click="ColumnSortClicked" Style="{StaticResource ColumnHeader}" Margin="0,0,12,0" ToolTipService.ToolTip="Sort by CPU %"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="2" AutomationProperties.Name="Resize CPU % column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="3" Visibility="{Binding IoVisibility, Source={StaticResource ProcessColumns}, Mode=OneWay}">
                                                    <TextBlock Text="I/O rate" FontSize="13" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="3" AutomationProperties.Name="Resize I/O rate column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="4" Visibility="{Binding ThreadsVisibility, Source={StaticResource ProcessColumns}, Mode=OneWay}">
                                                    <TextBlock Text="Threads" FontSize="13" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="4" AutomationProperties.Name="Resize Threads column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="5" Visibility="Collapsed">
                                                    <TextBlock Text="User" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="5" AutomationProperties.Name="Resize User column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="6" Visibility="Collapsed">
                                                    <TextBlock Text="Status" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="6" AutomationProperties.Name="Resize Status column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="7">
                                                    <Button Content="PID" Tag="PID" Click="ColumnSortClicked" Style="{StaticResource ColumnHeader}" Margin="0,0,12,0" ToolTipService.ToolTip="Sort by PID"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="7" AutomationProperties.Name="Resize PID column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ListView x:Name="ProcessList" Grid.Row="1" ItemsSource="{x:Bind Model.Rows}" SelectionMode="Single" SelectionChanged="ProcessSelectionChanged" DoubleTapped="ProcessDoubleTapped" ContainerContentChanging="ProcessContainerChanged" AutomationProperties.Name="Live process table" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="MinHeight" Value="32"/>
                                                    <Setter Property="Padding" Value="8,0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:ProcessRow">
                                                    <Grid Width="{Binding ContentWidth, Source={StaticResource ProcessColumns}, Mode=OneWay}" MinHeight="44" ToolTipService.ToolTip="{x:Bind GroupingReason}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding Name, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding Memory, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding Cpu, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding Io, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding Threads, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding User, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding Status, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding Pid, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.ColumnSpan="8" Background="{ThemeResource GroupSurface}" Opacity="0.45" Visibility="{x:Bind GroupVisibility, Mode=OneWay}" IsHitTestVisible="False"/>
                                                        <Border Grid.ColumnSpan="8" Background="{ThemeResource SelectionSurface}" Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" IsHitTestVisible="False"/>
                                                        <Border Grid.ColumnSpan="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
                                                        <Grid ColumnSpacing="6" Margin="4,0,8,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{x:Bind Indent}"/>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="1" Content="{x:Bind Chevron, Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="0" MinWidth="20" MinHeight="26" Background="Transparent" BorderThickness="0" Click="ExpandClicked" Tag="{x:Bind}" Visibility="{x:Bind ChevronVisibility, Mode=OneWay}" AutomationProperties.Name="Expand or collapse application group"/>
                                                            <Grid Grid.Column="2">
                                                                <FontIcon Glyph="&#xE8A5;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16"/>
                                                                <Image Width="20" Height="20" Loaded="ProcessIconLoaded" DataContextChanged="ProcessIconChanged"/>
                                                            </Grid>
                                                            <Grid Grid.Column="3" VerticalAlignment="Center" ColumnSpacing="4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <StackPanel ToolTipService.ToolTip="{x:Bind IdentityHelp, Mode=OneWay}">
                                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="{StaticResource DataSize}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{x:Bind RawName}" FontSize="{StaticResource CaptionSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Visibility="{x:Bind GroupVisibility, Mode=OneWay}">
                                                                    <TextBlock Text="{x:Bind Count, Mode=OneWay}" FontSize="13"/>
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Memory, Mode=OneWay}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" Style="{StaticResource NumericCell}"/>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Cpu, Mode=OneWay}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" Style="{StaticResource NumericCell}"/>
                                                        <TextBlock Grid.Column="3" Text="{x:Bind Io, Mode=OneWay}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" Style="{StaticResource NumericCell}" Visibility="{Binding IoVisibility, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                        <TextBlock Grid.Column="4" Text="{x:Bind Threads, Mode=OneWay}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" Style="{StaticResource NumericCell}" Visibility="{Binding ThreadsVisibility, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                        <TextBlock Grid.Column="5" Text="{x:Bind User, Mode=OneWay}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" Style="{StaticResource DataCell}" Visibility="Collapsed"/>
                                                        <Border Grid.Column="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="7" Text="{x:Bind Pid, Mode=OneWay}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" Style="{StaticResource NumericCell}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </ScrollViewer>
                                <TextBlock Margin="24,55,24,24" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" Style="{StaticResource Muted}" Text="{x:Bind Model.EmptyMessage, Mode=OneWay}" Visibility="{x:Bind Model.EmptyVisibility, Mode=OneWay}" AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Private commit is not physical RAM · — Unavailable" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" ToolTipService.ToolTip="Process state is not inferred. Groups use the same executable, owner and observed parent chain. Inspect a selected member for details."/>
                            <Button x:Name="DetailsButton" Grid.Column="1" Content="Details" Click="DetailsClicked" Visibility="Collapsed" AutomationProperties.Name="Inspect selected process"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="Inspector" Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Grid ColumnSpacing="10" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid VerticalAlignment="Top" Margin="0,4,0,0">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="28"/>
                                            <Image x:Name="SelectedIcon" Width="32" Height="32"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock x:Name="SelectedName" Text="Process inspector" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="SelectedRawName" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="SelectedIdentity" Text="Select a process to see its details." Style="{StaticResource Muted}" FontSize="13"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="12" Padding="0,8" BorderBrush="{ThemeResource SubtleBorder}" BorderThickness="0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Private commit" FontSize="13"/><TextBlock x:Name="SelectedCommit" Text="—" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="CPU" FontSize="13"/><TextBlock x:Name="SelectedCpu" Text="—" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                                    </Grid>
                                    <controls:InspectorRow x:Name="SelectedPath" Glyph="&#xE8A5;" Label="Executable path" Value="—"/>
                                    <controls:InspectorRow x:Name="SelectedOwner" Glyph="&#xE77B;" Label="User" Value="—"/>
                                    <controls:InspectorRow x:Name="SelectedParent" Glyph="&#xE8FD;" Label="Parent process" Value="—"/>
                                    <controls:InspectorRow x:Name="SelectedServices" Glyph="&#xE713;" Label="Associated services" Value="—"/>
                                    <controls:InspectorRow x:Name="SelectedNetwork" Glyph="&#xE701;" Label="Network endpoints" Value="—"/>
                                    <Expander Header="Advanced details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,10,0,0">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="SelectedStatus" Text="No selection" Style="{StaticResource Muted}"/>
                                            <TextBlock x:Name="SelectedAvailability" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="Command line" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock x:Name="SelectedCommandLine" Text="—" Style="{StaticResource Muted}" IsTextSelectionEnabled="True"/>
                                            <TextBlock x:Name="SelectedMemory" Text="—" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="Private commit is not physical RAM. Working sets include shared pages. Observed does not imply a running state." Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Quick actions" Style="{StaticResource SectionLabel}" ToolTipService.ToolTip="Read-only actions. No process control or automatic elevation."/>
                                <Grid ColumnSpacing="6" RowSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Button x:Name="OpenLocation" Content="Open folder" Click="OpenLocationClicked" HorizontalAlignment="Stretch" IsEnabled="False"/>
                                    <Button x:Name="CopyPid" Grid.Column="1" Content="Copy PID" Click="CopyPidClicked" HorizontalAlignment="Stretch" IsEnabled="False" AutomationProperties.HelpText="Copy the observed PID of the selected member, not every grouped process."/>
                                    <Button x:Name="CopyPath" Grid.Row="1" Content="Copy path" Click="CopyPathClicked" HorizontalAlignment="Stretch" IsEnabled="False"/>
                                    <Button x:Name="PublisherButton" Grid.Row="1" Grid.Column="1" Content="Publisher" Click="PublisherClicked" HorizontalAlignment="Stretch" IsEnabled="False"/>
                                </Grid>
                                <TextBlock x:Name="PublisherText" Style="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                <views:OverviewView x:Name="OverviewPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"/>
                <Grid x:Name="DiagnosticsPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="ChartCard" Style="{StaticResource Card}">
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="ChartTitle" Text="Recent history" FontWeight="SemiBold"/>
                            <Canvas x:Name="HistoryChart" Height="110" SizeChanged="ChartSizeChanged"/>
                            <TextBlock x:Name="ChartLegend" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <ListView x:Name="DetailsList" Grid.Row="1" SelectionMode="None" AutomationProperties.Name="Diagnostic measurements">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="{StaticResource BodySize}"/>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
                <StackPanel x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" Spacing="16">
                    <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="ThemeChanged" AutomationProperties.Name="Color theme">
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                        <x:String>System</x:String>
                    </ComboBox>
                    <TextBlock Text="Local and read-only. Process information is never uploaded. Refresh is every two seconds; pause stops new samples. History is bounded to 180 samples and is not saved to disk." TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </NavigationView>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="20,4" Text="Starting local Windows monitoring…" FontSize="11" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
