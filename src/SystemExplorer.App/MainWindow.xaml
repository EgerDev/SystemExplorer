<Window
    x:Class="SystemExplorer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.App"
    xmlns:controls="using:SystemExplorer.App.Controls"
    Title="SystemExplorer">
    <Grid x:Name="Root" Background="{ThemeResource PageSurface}" RequestedTheme="Light">
        <Grid.Resources>
            <controls:ProcessColumns x:Key="ProcessColumns"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Grid Padding="20,10" ColumnSpacing="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="7" Width="32" Height="32">
                    <FontIcon Glyph="&#xE9D9;" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="20"/>
                </Border>
                <TextBlock Text="SystemExplorer" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <AutoSuggestBox x:Name="GlobalSearch" Grid.Column="1" PlaceholderText="Search processes, services, or connections…  Ctrl+K" QueryIcon="Find" TextChanged="GlobalSearchChanged" AutomationProperties.Name="Search current section" MaxWidth="650" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" x:Name="PauseButton" Content="Pause" Click="PauseClicked" AutomationProperties.Name="Pause live refresh"/>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" ExpandedModeThresholdWidth="1100" CompactModeThresholdWidth="640" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="192" CompactPaneLength="48" IsPaneToggleButtonVisible="True" SelectionChanged="NavigationChanged" AlwaysShowHeader="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Overview" Icon="Home"/>
                <NavigationViewItem Content="Processes" Tag="Processes" Icon="AllApps" IsSelected="True"/>
                <NavigationViewItem Content="Memory" Tag="Memory">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="CPU" Tag="CPU">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="GPU" Tag="GPU">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Disks" Tag="Disks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Network" Tag="Network" Icon="World"/>
                <NavigationViewItem Content="Services" Tag="Services" Icon="Repair"/>
                <NavigationViewItem Content="Startup" Tag="Startup" Icon="Play"/>
                <NavigationViewItem Content="Insights" Tag="Insights">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA80;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting"/>
                <NavigationViewItem Content="Help" Tag="Help" Icon="Help"/>
            </NavigationView.FooterMenuItems>
            <Grid Padding="16,8,16,12" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="PageTitle" Text="Processes" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Live Windows processes, grouped conservatively by executable and parent chain." Style="{StaticResource Muted}"/>
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <controls:SummaryCard Grid.Column="0" Label="Total processes" Value="{x:Bind Model.ProcessCount, Mode=OneWay}" Glyph="&#xE950;"/>
                    <controls:SummaryCard Grid.Column="1" Label="Application groups" Value="{x:Bind Model.GroupCount, Mode=OneWay}" Glyph="&#xE8FD;"/>
                    <controls:SummaryCard Grid.Column="2" Label="Physical memory used" Value="{x:Bind Model.MemoryUsed, Mode=OneWay}" Glyph="&#xE964;"/>
                    <controls:SummaryCard Grid.Column="3" Label="System CPU" Value="{x:Bind Model.CpuUsed, Mode=OneWay}" Glyph="&#xE9D9;"/>
                </Grid>
                <Grid x:Name="ProcessesPanel" Grid.Row="2" ColumnSpacing="12" SizeChanged="ProcessesSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="InspectorColumn" Width="320"/>
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProcessSearch" PlaceholderText="Search processes…" TextChanged="ProcessSearchChanged" AutomationProperties.Name="Filter processes"/>
                            <ComboBox x:Name="Grouping" Grid.Column="1" SelectedIndex="0" SelectionChanged="OptionsChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Group processes">
                                <x:String>Application</x:String>
                                <x:String>Individual</x:String>
                            </ComboBox>
                            <ComboBox x:Name="Sorting" Grid.Column="2" SelectedIndex="0" SelectionChanged="OptionsChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort processes">
                                <x:String>Private commit</x:String>
                                <x:String>CPU</x:String>
                                <x:String>Name</x:String>
                                <x:String>PID</x:String>
                            </ComboBox>
                            <Button Grid.Column="3" Click="ReverseSortClicked" AutomationProperties.Name="Reverse sort direction" ToolTipService.ToolTip="Reverse sort direction">
                                <FontIcon Glyph="&#xE8CB;" FontSize="15"/>
                            </Button>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" IsTabStop="False">
                                    <Grid Width="{Binding TableWidth, Source={StaticResource ProcessColumns}, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{ThemeResource HeaderSurface}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Grid Width="{Binding ContentWidth, Source={StaticResource ProcessColumns}, Mode=OneWay}" HorizontalAlignment="Left" Margin="8,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Name, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding Memory, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding Cpu, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding Io, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding Threads, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding User, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding Status, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding Pid, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Button Content="Process name" Tag="Name" Click="ColumnSortClicked" Style="{StaticResource ColumnHeader}" Margin="0,0,12,0" ToolTipService.ToolTip="Sort by Process name"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="0" AutomationProperties.Name="Resize Process name column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="1">
                                                    <Button Content="Private commit" Tag="Private memory" Click="ColumnSortClicked" Style="{StaticResource ColumnHeader}" Margin="0,0,12,0" ToolTipService.ToolTip="Private commit is not physical RAM"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="1" AutomationProperties.Name="Resize Private commit column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="2">
                                                    <Button Content="CPU %" Tag="CPU" Click="ColumnSortClicked" Style="{StaticResource ColumnHeader}" Margin="0,0,12,0" ToolTipService.ToolTip="Sort by CPU %"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="2" AutomationProperties.Name="Resize CPU % column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="3">
                                                    <TextBlock Text="I/O rate" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="3" AutomationProperties.Name="Resize I/O rate column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="4">
                                                    <TextBlock Text="Threads" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="4" AutomationProperties.Name="Resize Threads column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="5">
                                                    <TextBlock Text="User" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="5" AutomationProperties.Name="Resize User column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="6">
                                                    <TextBlock Text="Status" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="6" AutomationProperties.Name="Resize Status column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                                <Grid Grid.Column="7">
                                                    <Button Content="PID" Tag="PID" Click="ColumnSortClicked" Style="{StaticResource ColumnHeader}" Margin="0,0,12,0" ToolTipService.ToolTip="Sort by PID"/>
                                                    <controls:ColumnResizeHandle Columns="{StaticResource ProcessColumns}" ColumnIndex="7" AutomationProperties.Name="Resize PID column" AutomationProperties.HelpText="Left / Right change width. Home / End set minimum / maximum."/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ListView x:Name="ProcessList" Grid.Row="1" ItemsSource="{x:Bind Model.Rows}" SelectionMode="Single" SelectionChanged="ProcessSelectionChanged" DoubleTapped="ProcessDoubleTapped" ContainerContentChanging="ProcessContainerChanged" AutomationProperties.Name="Live process table" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="MinHeight" Value="32"/>
                                                    <Setter Property="Padding" Value="8,0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:ProcessRow">
                                                    <Grid Width="{Binding ContentWidth, Source={StaticResource ProcessColumns}, Mode=OneWay}" MinHeight="32" ToolTipService.ToolTip="{x:Bind GroupingReason}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding Name, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding Memory, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding Cpu, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding Io, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding Threads, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding User, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding Status, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                            <ColumnDefinition Width="{Binding Pid, Source={StaticResource ProcessColumns}, Mode=OneWay}"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.ColumnSpan="8" Background="{ThemeResource GroupSurface}" Opacity="0.45" Visibility="{x:Bind GroupVisibility, Mode=OneWay}" IsHitTestVisible="False"/>
                                                        <Border Grid.ColumnSpan="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
                                                        <Grid ColumnSpacing="6" Margin="4,0,8,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{x:Bind Indent}"/>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="1" Content="{x:Bind Chevron, Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="0" MinWidth="20" MinHeight="26" Background="Transparent" BorderThickness="0" Click="ExpandClicked" Tag="{x:Bind}" Visibility="{x:Bind ChevronVisibility, Mode=OneWay}" AutomationProperties.Name="Expand or collapse application group"/>
                                                            <Grid Grid.Column="2">
                                                                <FontIcon Glyph="&#xE8A5;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16"/>
                                                                <Image Width="20" Height="20" Loaded="ProcessIconLoaded" DataContextChanged="ProcessIconChanged"/>
                                                            </Grid>
                                                            <TextBlock Grid.Column="3" Text="{x:Bind Name, Mode=OneWay}" FontSize="13" FontWeight="{x:Bind RowWeight, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Memory, Mode=OneWay}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" Style="{StaticResource NumericCell}"/>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Cpu, Mode=OneWay}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" Style="{StaticResource NumericCell}"/>
                                                        <TextBlock Grid.Column="3" Text="{x:Bind Io, Mode=OneWay}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" Style="{StaticResource NumericCell}"/>
                                                        <TextBlock Grid.Column="4" Text="{x:Bind Threads, Mode=OneWay}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" Style="{StaticResource NumericCell}"/>
                                                        <TextBlock Grid.Column="5" Text="{x:Bind User, Mode=OneWay}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" Style="{StaticResource DataCell}"/>
                                                        <Border Grid.Column="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="7" Text="{x:Bind Pid, Mode=OneWay}" FontWeight="{x:Bind RowWeight, Mode=OneWay}" Style="{StaticResource NumericCell}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </ScrollViewer>
                                <TextBlock Margin="24,55,24,24" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" Style="{StaticResource Muted}" Text="{x:Bind Model.EmptyMessage, Mode=OneWay}" Visibility="{x:Bind Model.EmptyVisibility, Mode=OneWay}" AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Observed ≠ running state · — means unavailable · Private commit ≠ RAM" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                            <Button x:Name="DetailsButton" Grid.Column="1" Content="Details" Click="DetailsClicked" Visibility="Collapsed" AutomationProperties.Name="Inspect selected process"/>
                        </Grid>
                    </Grid>
                    <ScrollViewer x:Name="Inspector" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="PROCESS INSPECTOR" FontSize="11" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="SelectedName" Text="Select a process" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="7,3" HorizontalAlignment="Left">
                                        <TextBlock x:Name="SelectedStatus" Text="No selection" FontSize="12"/>
                                    </Border>
                                    <TextBlock x:Name="SelectedIdentity" Text="Select a process to inspect its live measurements." Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="SelectedAvailability" Style="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Executable" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="Executable path" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="SelectedPath" Text="—" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13"/>
                                    <TextBlock Text="Command line" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="SelectedCommandLine" Text="—" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Ownership" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock x:Name="SelectedOwner" Text="—" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="Parent process" Style="{StaticResource SectionLabel}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="SelectedParent" Text="—" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Memory" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock x:Name="SelectedMemory" Text="—" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="Private commit is not physical RAM. Working sets include shared pages." Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Relationships" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="Associated services" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="SelectedServices" Text="—" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="Network endpoints" Style="{StaticResource SectionLabel}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="SelectedNetwork" Text="—" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Read-only actions" Style="{StaticResource SectionLabel}"/>
                                    <Button x:Name="OpenLocation" Content="Open file location" Click="OpenLocationClicked" Style="{StaticResource ReadOnlyAction}" IsEnabled="False"/>
                                    <Button x:Name="CopyPath" Content="Copy executable path" Click="CopyPathClicked" Style="{StaticResource ReadOnlyAction}" IsEnabled="False"/>
                                    <Button x:Name="PublisherButton" Content="Inspect publisher" Click="PublisherClicked" Style="{StaticResource ReadOnlyAction}" IsEnabled="False"/>
                                    <TextBlock x:Name="PublisherText" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="Read-only monitoring. No termination, suspension or automatic elevation." Style="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="DiagnosticsPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="ChartCard" Style="{StaticResource Card}">
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="ChartTitle" Text="Recent history" FontWeight="SemiBold"/>
                            <Canvas x:Name="HistoryChart" Height="110" SizeChanged="ChartSizeChanged"/>
                            <TextBlock x:Name="ChartLegend" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <ListView x:Name="DetailsList" Grid.Row="1" SelectionMode="None" AutomationProperties.Name="Diagnostic measurements">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="{StaticResource BodySize}"/>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
                <StackPanel x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" Spacing="16">
                    <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="ThemeChanged" AutomationProperties.Name="Color theme">
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                        <x:String>System</x:String>
                    </ComboBox>
                    <TextBlock Text="Local and read-only. Process information is never uploaded. Refresh is every two seconds; pause stops new samples. History is bounded to 180 samples and is not saved to disk." TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </NavigationView>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="20,4" Text="Starting local Windows monitoring…" FontSize="11" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
