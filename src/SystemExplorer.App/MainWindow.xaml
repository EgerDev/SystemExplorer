<Window
    x:Class="SystemExplorer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.App"
    Title="SystemExplorer">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RequestedTheme="Light">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
        <Grid Padding="20,6" ColumnSpacing="22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9D9;" Foreground="#0067C0" FontSize="24"/>
                <TextBlock Text="SystemExplorer" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <AutoSuggestBox x:Name="GlobalSearch" Grid.Column="1" PlaceholderText="Search processes, services, or connections…  Ctrl+K" QueryIcon="Find" TextChanged="GlobalSearchChanged" AutomationProperties.Name="Search current section" MaxWidth="650" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" x:Name="PauseButton" Content="Pause" Click="PauseClicked" AutomationProperties.Name="Pause live refresh"/>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="180" CompactPaneLength="48" IsPaneToggleButtonVisible="True" SelectionChanged="NavigationChanged" AlwaysShowHeader="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Overview" Icon="Home"/>
                <NavigationViewItem Content="Processes" Tag="Processes" Icon="AllApps" IsSelected="True"/>
                <NavigationViewItem Content="Memory" Tag="Memory"><NavigationViewItem.Icon><FontIcon Glyph="&#xE950;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="CPU" Tag="CPU"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="GPU" Tag="GPU"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Disks" Tag="Disks"><NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Network" Tag="Network" Icon="World"/>
                <NavigationViewItem Content="Services" Tag="Services" Icon="Repair"/>
                <NavigationViewItem Content="Startup" Tag="Startup" Icon="Play"/>
                <NavigationViewItem Content="Insights" Tag="Insights"><NavigationViewItem.Icon><FontIcon Glyph="&#xEA80;"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting"/>
                <NavigationViewItem Content="Help" Tag="Help" Icon="Help"/>
            </NavigationView.FooterMenuItems>
            <Grid Padding="16,8,16,12" RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="PageTitle" Text="Processes" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Live Windows processes, grouped conservatively by executable and parent chain." Style="{StaticResource Muted}"/>
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Total processes" Style="{StaticResource Muted}"/><TextBlock Text="{x:Bind Model.ProcessCount, Mode=OneWay}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Application groups" Style="{StaticResource Muted}"/><TextBlock Text="{x:Bind Model.GroupCount, Mode=OneWay}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Physical memory used" Style="{StaticResource Muted}"/><TextBlock Text="{x:Bind Model.MemoryUsed, Mode=OneWay}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="System CPU" Style="{StaticResource Muted}"/><TextBlock Text="{x:Bind Model.CpuUsed, Mode=OneWay}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Border>
                </Grid>
                <Grid x:Name="ProcessesPanel" Grid.Row="2" ColumnSpacing="12" SizeChanged="ProcessesSizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="290"/></Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ProcessSearch" PlaceholderText="Search processes…" TextChanged="ProcessSearchChanged" AutomationProperties.Name="Filter processes"/>
                            <ComboBox x:Name="Grouping" Grid.Column="1" SelectedIndex="0" SelectionChanged="OptionsChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Group processes">
                                <x:String>Application</x:String><x:String>Individual</x:String>
                            </ComboBox>
                            <ComboBox x:Name="Sorting" Grid.Column="2" SelectedIndex="0" SelectionChanged="OptionsChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort processes">
                                <x:String>Private memory</x:String><x:String>CPU</x:String><x:String>Name</x:String><x:String>PID</x:String>
                            </ComboBox>
                            <Button Grid.Column="3" Click="ReverseSortClicked" AutomationProperties.Name="Reverse sort direction" ToolTipService.ToolTip="Reverse sort direction"><FontIcon Glyph="&#xE8CB;" FontSize="15"/></Button>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Padding="10,0" ColumnSpacing="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/><ColumnDefinition Width="58"/><ColumnDefinition Width="68"/><ColumnDefinition Width="52"/><ColumnDefinition Width="92"/><ColumnDefinition Width="78"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                    <Button Content="Process name" Tag="Name" Click="ColumnSortClicked" FontSize="12" Padding="0" Background="Transparent" BorderThickness="0"/>
                                    <Button Grid.Column="1" Content="Private commit" Tag="Private memory" Click="ColumnSortClicked" FontSize="11" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Private committed memory, not physical RAM"/>
                                    <Button Grid.Column="2" Content="CPU %" Tag="CPU" Click="ColumnSortClicked" FontSize="11" Padding="0" Background="Transparent" BorderThickness="0"/>
                                    <TextBlock Grid.Column="3" Text="I/O rate" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Threads" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="User" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="Status" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Grid.Column="7" Content="PID" Tag="PID" Click="ColumnSortClicked" FontSize="11" Padding="0" Background="Transparent" BorderThickness="0"/>
                                </Grid>
                                <ListView x:Name="ProcessList" Grid.Row="1" ItemsSource="{x:Bind Model.Rows}" SelectionMode="Single" SelectionChanged="ProcessSelectionChanged" DoubleTapped="ProcessDoubleTapped" ContainerContentChanging="ProcessContainerChanged" AutomationProperties.Name="Live process table">
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,1"/></Style></ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:ProcessRow">
                                            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind GroupingReason}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/><ColumnDefinition Width="58"/><ColumnDefinition Width="68"/><ColumnDefinition Width="52"/><ColumnDefinition Width="92"/><ColumnDefinition Width="78"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                <Grid ColumnSpacing="5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{x:Bind Indent}"/><ColumnDefinition Width="22"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Button Grid.Column="1" Content="{x:Bind Chevron, Mode=OneWay}" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="0" MinWidth="20" MinHeight="24" Background="Transparent" BorderThickness="0" Click="ExpandClicked" Tag="{x:Bind}" AutomationProperties.Name="Expand or collapse application group"/>
                                                    <Grid Grid.Column="2"><FontIcon Glyph="&#xE8A5;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16"/><Image Width="20" Height="20" Loaded="ProcessIconLoaded" DataContextChanged="ProcessIconChanged"/></Grid>
                                                    <TextBlock Grid.Column="3" Text="{x:Bind Name, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Memory, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{x:Bind Cpu, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{x:Bind Io, Mode=OneWay}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{x:Bind Threads, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{x:Bind User, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{x:Bind Status, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="7" Text="{x:Bind Pid, Mode=OneWay}" FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Grid.Row="1" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" Style="{StaticResource Muted}" Text="{x:Bind Model.EmptyMessage, Mode=OneWay}" Visibility="{x:Bind Model.EmptyVisibility, Mode=OneWay}" AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ScrollViewer x:Name="Inspector" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="SelectedName" Text="Process inspector" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SelectedIdentity" Text="Select a process to inspect its live measurements." Style="{StaticResource Muted}"/>
                                    <TextBlock Text="Executable path" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="SelectedPath" Text="—" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/>
                                    <TextBlock Text="Command line" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="SelectedCommandLine" Text="—" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/>
                                    <TextBlock Text="Parent process" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="SelectedParent" Text="—" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="Memory" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="SelectedMemory" Text="—" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="Associated services" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="SelectedServices" Text="—" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="Network endpoints" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="SelectedNetwork" Text="—" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="SelectedAvailability" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Read-only actions" FontWeight="SemiBold"/>
                                    <Button x:Name="OpenLocation" Content="Open file location" Click="OpenLocationClicked" HorizontalAlignment="Stretch" IsEnabled="False"/>
                                    <Button x:Name="CopyPath" Content="Copy executable path" Click="CopyPathClicked" HorizontalAlignment="Stretch" IsEnabled="False"/>
                                    <Button x:Name="PublisherButton" Content="Inspect publisher" Click="PublisherClicked" HorizontalAlignment="Stretch" IsEnabled="False"/>
                                    <TextBlock x:Name="PublisherText" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="Termination and suspension are intentionally unavailable. Monitoring never requests elevation." Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="DiagnosticsPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="ChartCard" Style="{StaticResource Card}">
                        <StackPanel Spacing="5"><TextBlock x:Name="ChartTitle" Text="Recent history" FontWeight="SemiBold"/><Canvas x:Name="HistoryChart" Height="110" SizeChanged="ChartSizeChanged"/><TextBlock x:Name="ChartLegend" Style="{StaticResource Muted}"/></StackPanel>
                    </Border>
                    <ListView x:Name="DetailsList" Grid.Row="1" SelectionMode="None" AutomationProperties.Name="Diagnostic measurements">
                        <ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8"><TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="14"/></Border></DataTemplate></ListView.ItemTemplate>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
                <StackPanel x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" Spacing="16">
                    <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ThemeSelector" SelectedIndex="0" SelectionChanged="ThemeChanged" AutomationProperties.Name="Color theme"><x:String>Light</x:String><x:String>Dark</x:String><x:String>System</x:String></ComboBox>
                    <TextBlock Text="Local and read-only. Process information is never uploaded. Refresh is every two seconds; pause stops new samples. History is bounded to 180 samples and is not saved to disk." TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </NavigationView>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="20,4" Text="Starting local Windows monitoring…" FontSize="11" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
